            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "allocation_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "allocation_basis": {
            "enum": [
              "owner_residence",
              "vehicle_registration"
            ]
          },
          "value_status": {
            "enum": [
              "official_projection",
              "model_derived_scenario",
              "engineering_assumption"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "assumption_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "district_id",
          "district_name",
          "province_name",
          "year",
          "scenario",
          "allocation_share",
          "allocation_basis",
          "value_status",
          "evidence_id",
          "assumption_id",
          "rationale"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "value_status": {
                  "enum": [
                    "model_derived_scenario",
                    "engineering_assumption"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "assumption_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "parameter_or_rule": {
            "type": "string",
            "minLength": 1
          },
          "applicable_scope": {
            "type": "string",
            "minLength": 1
          },
          "value_or_rule": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity_plan": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "assumption_id",
          "parameter_or_rule",
          "applicable_scope",
          "value_or_rule",
          "rationale",
          "evidence_ids",
          "sensitivity_plan"
        ]
      }
    }
  },
  "required": [
    "scope",
    "national_inputs",
    "district_allocations",
    "assumptions"
  ],
