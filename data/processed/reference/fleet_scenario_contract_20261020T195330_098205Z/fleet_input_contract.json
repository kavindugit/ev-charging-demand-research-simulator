{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "vehicle_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "powertrain_scope": {
          "enum": [
            "BEV_only",
            "BEV_and_PHEV",
            "reported_Electric_category"
          ]
        },
        "count_basis": {
          "enum": [
            "active_vehicle_stock",
            "registered_vehicle_population",
            "registration_cohort",
            "conditional_scenario_stock"
          ]
        },
        "national_method": {
          "enum": [
            "supplied_national_counts",
            "conditional_penetration"
          ]
        },
        "district_fleet_basis": {
          "enum": [
            "owner_residence",
            "vehicle_registration"
          ]
        },
        "count_representation": {
          "enum": [
            "expected_vehicles",
            "integer_vehicles"
          ]
        },
        "integerization_reference": {
          "type": "string"
        },
        "definition_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_model_reference": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_class_compatibility_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope_id",
        "vehicle_classes",
        "powertrain_scope",
        "count_basis",
        "national_method",
        "district_fleet_basis",
        "count_representation",
        "integerization_reference",
        "definition_evidence_id",
        "behaviour_model_reference",
        "behaviour_class_compatibility_reference"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "count_representation": {
                "const": "integer_vehicles"
              }
            }
          },
          "then": {
            "properties": {
              "integerization_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "national_inputs": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "year": {
            "enum": [
              2026,
              2027,
              2028,
              2029,
              2030,
              2031,
              2032,
              2033,
              2034,
              2035
            ]
          },
          "scenario": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "national_method": {
            "enum": [
              "supplied_national_counts",
              "conditional_penetration"
            ]
          },
          "count_basis": {
            "enum": [
              "active_vehicle_stock",
              "registered_vehicle_population",
              "registration_cohort",
              "conditional_scenario_stock"
            ]
          },
          "national_ev_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "all_fuel_population": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ev_stock_share": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "value_status": {
            "enum": [
              "official_projection",
              "model_derived_scenario",
              "engineering_assumption"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "assumption_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "year",
          "scenario",
          "national_method",
          "count_basis",
          "national_ev_count",
          "all_fuel_population",
          "ev_stock_share",
          "value_status",
          "evidence_id",
          "assumption_id",
          "rationale"
        ],
        "oneOf": [
          {
            "properties": {
              "national_method": {
                "const": "supplied_national_counts"
              },
              "national_ev_count": {
                "type": "number",
                "minimum": 0
              },
              "all_fuel_population": {
                "type": "null"
              },
              "ev_stock_share": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "national_method": {
                "const": "conditional_penetration"
              },
              "count_basis": {
                "const": "conditional_scenario_stock"
              },
              "national_ev_count": {
                "type": "null"
              },
              "all_fuel_population": {
                "type": "number",
                "minimum": 0
              },
              "ev_stock_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "value_status": {
                  "enum": [
                    "model_derived_scenario",
                    "engineering_assumption"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "assumption_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "district_allocations": {
      "type": "array",
      "minItems": 750,
      "maxItems": 750,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
